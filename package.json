{
  "name": "dsh-settings-groups",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 设置导航分组：紧凑分组标签、自由拖拽排序、分组与未分组随意派发，带展开/收起过渡动画。 / Compact, drag-and-drop groups for the DeepSeek Harness settings sidebar.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "sidebar",
    "navigation",
    "groups",
    "drag-and-drop"
  ],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/profile.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-plugin": "node scripts/profile.mjs install",
    "uninstall-plugin": "node scripts/profile.mjs uninstall",
    "check-plugin": "node scripts/profile.mjs check",
    "test": "node test/host.mjs && node test/run.mjs",
    "test:browser": "node test/run.mjs",
    "test:host": "node test/host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AumiSatori/dsh-settings-groups.git"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
